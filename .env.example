# Copy this file to .env and fill it in. .env is private and never committed.

# Amazon Bedrock API key (sent as a bearer token) with access to Amazon Nova.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Text model that picks the concepts for each Lotería.
NOVA_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Port for the web server.
PORT=3000

# Daily limits for the requests that use the AI (they protect your AWS credit on a public link).
DAILY_DECKS=100
DAILY_MORE=300
